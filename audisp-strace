    def handle_memfd_create(self, event):
        name = None
        if event.paths:
            name = event.paths[0].get("name")
        if not name and self.resolver and self.resolver.is_live:
            pid = event.pid
            fd = event.exit_code
            if pid and fd is not None and fd >= 0:
                link = self.resolver.get_fd_path(pid, fd)
                if link and "memfd:" in link:
                    name = link.split("memfd:", 1)[1].split(" (deleted)")[0]
        if not name:
            name = self._get_pathname(event, "a0")
        name = name.strip('"')
        flags_val = self._parse_id(event.syscall.get("a1", "0"))
        flags_str = self._format_memfd_flags(flags_val)
        return f'memfd_create("{name}", {flags_str}) = {event.exit_str}'

