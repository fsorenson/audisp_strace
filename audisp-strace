    def handle_preadv_pwritev(self, event, scname=None):
        scname = scname or event.syscall_name
        fd_str = self._resolve_fd(event, "a0")
        iovcnt = self._parse_id(event.syscall.get("a2", "0"))
        offset = self._parse_id(event.syscall.get("a3", "0"))
        flags_str = ""
        if scname in ("preadv2", "pwritev2"):
            flags_val = self._parse_id(event.syscall.get("a4", "0"))
            flags_str = f", {flags_val}"
        return f"{scname}({fd_str}, [...], {iovcnt}, {offset}{flags_str}) = {event.exit_str}"

    def handle_sendfile(self, event, scname=None):
        scname = scname or event.syscall_name or "sendfile"
        out_fd = self._resolve_fd(event, "a0")
        in_fd = self._resolve_fd(event, "a1")
        offset_ptr = self._parse_id(event.syscall.get("a2", "0"))
        offset_str = "NULL" if offset_ptr == 0 else "[...]"
        count = self._parse_id(event.syscall.get("a3", "0"))
        return f"{scname}({out_fd}, {in_fd}, {offset_str}, {count}) = {event.exit_str}"

    def handle_fcntl(self, event):
        fd_str = self._resolve_fd(event, "a0")
        cmd_val = self._parse_id(event.syscall.get("a1", "0"))
        cmd_str = FCNTL_CMDS.get(cmd_val, str(cmd_val))
        arg_val = self._parse_id(event.syscall.get("a2", "0"))

        if cmd_str == "F_SETFD":
            arg_str = "FD_CLOEXEC" if arg_val == 1 else str(arg_val)
        elif cmd_str in ("F_GETFD", "F_GETFL", "F_GETPIPE_SZ", "F_GETOWN"):
            return f"fcntl({fd_str}, {cmd_str}) = {event.exit_str}"
        elif cmd_str == "F_SETFL":
            arg_str = event.syscall_interp.get("a2") or str(arg_val)
        else:
            arg_str = str(arg_val)
        return f"fcntl({fd_str}, {cmd_str}, {arg_str}) = {event.exit_str}"

    def handle_ioctl(self, event):
        fd_str = self._resolve_fd(event, "a0")
        req_val = self._parse_id(event.syscall.get("a1", "0"))
        req_str = COMMON_IOCTLS.get(req_val, f"0x{req_val:x}")
        arg_val = self._parse_id(event.syscall.get("a2", "0"))
        arg_str = f"0x{arg_val:x}" if arg_val else "NULL"
        return f"ioctl({fd_str}, {req_str}, {arg_str}) = {event.exit_str}"

    def format_event(self, event, caller_comm=None):
        scname = event.syscall_name
        if not scname:
            return None

        handler = self._handlers.get(scname)
        if handler:
            call_str = handler(event)
        else:
            call_str = f"{scname}(...) = {event.exit_str}"

        # Line 1 header: <pid><comm> <timestamp> <call_str>
        comm = caller_comm or event.comm or self.tracker._resolve_name(event.pid)
        ts_str = self.formatter.format_timestamp(event.sec, event.milli)
        line1 = f"{event.pid}<{comm}> {ts_str} {call_str}"

        # Line 2: Process credentials
        line2 = self.formatter.format_credentials(event)

        # Line 3: Process ancestry tree
        ancestry = self.tracker.get_ancestry(event.pid)
        line3 = self.formatter.format_ancestry(ancestry)

        return f"{line1}\n{line2}\n{line3}"


def _auparse_callback(au, event_type, user_data):
    if user_data:
        user_data.on_audit_event(au, event_type)


class AudispStraceApp:
    """Coordinates parsing, state tracking, and output generation."""

    def __init__(self, is_live=False, time_format="time", all_syscalls=False,
                 syscalls=None, exclude_syscalls=None):
        self.is_live = is_live
        self.all_syscalls = all_syscalls
        self.syscall_filter = set(syscalls) if syscalls is not None else None
        self.exclude_filter = set(exclude_syscalls) if exclude_syscalls is not None else set()
        self.resolver = ProcResolver(is_live=is_live)
        self.tracker = ProcessTracker(self.resolver)
        self.formatter = TraceFormatter(time_format=time_format)
        self.handler = SyscallHandler(self.tracker, self.resolver, self.formatter)

        self.au = auparse.AuParser(auparse.AUSOURCE_FEED)
        self.au.add_callback(_auparse_callback, self)

    def on_audit_event(self, au, event_type):
        if event_type != auparse.AUPARSE_CB_EVENT_READY:
            return

        au.first_record()
        rectype = au.get_type_name()
        if rectype in IGNORE_RECORD_TYPES:
            return

        event = AuditEvent(au)
        scname = event.syscall_name
        if not scname:
            return

        pid = event.pid
        ppid = event.ppid
        comm = event.comm
        exe = event.exe
        ses = event.syscall.get("ses")

        # For execve, preserve prior caller comm if available
        caller_comm = None
        if scname in ('execve', 'execveat'):
            prior = self.tracker.get_proc(pid)
            if prior and prior.get('comm'):
                caller_comm = prior['comm']
            elif event.proctitle:
                caller_comm = event.proctitle.lstrip('-').split()[0]

        self.tracker.update(pid, ppid=ppid, comm=comm, exe=exe, ses=ses)

        # Handle clone: child PID is in 'exit' field
        if scname in ('clone', 'clone3', 'fork', 'vfork'):
            child_pid = event.exit_code
            if child_pid and child_pid > 0:
                self.tracker.update(child_pid, ppid=pid, comm=comm, exe=exe, ses=ses)
                self.tracker.copy_fds(pid, child_pid)

        # Handle execve: update command line and binary
        if scname in ('execve', 'execveat'):
            self.tracker.update(pid, ppid=ppid, comm=comm, exe=exe, cmdline=event.execve_args, ses=ses)

        # Format event FIRST (so calls like close(fd) can resolve the path before removal)
        formatted = None
        should_display = False
        if scname not in self.exclude_filter:
            if self.syscall_filter is not None:
                should_display = scname in self.syscall_filter
            elif self.all_syscalls:
                should_display = True
            else:
                should_display = scname in DEFAULT_MONITORED_SYSCALLS

        if should_display:
            formatted = self.handler.format_event(event, caller_comm=caller_comm)

        # Update FD table based on syscall
        if scname in ('open', 'openat', 'openat2', 'creat'):
            if event.exit_code is not None and event.exit_code >= 0:
                opened_path = self.handler.get_opened_path(event)
                is_cloexec = self.handler.is_cloexec_opened(event)
                if opened_path:
                    self.tracker.set_fd(pid, event.exit_code, opened_path, cloexec=is_cloexec)

        elif scname == 'close':
            if event.exit_code == 0 or event.success == 'yes':
                fd_raw = event.syscall.get("a0", "0")
                self.tracker.close_fd(pid, fd_raw)

        elif scname == 'dup':
            if event.exit_code is not None and event.exit_code >= 0:
                oldfd = event.syscall.get("a0", "0")
                self.tracker.dup_fd(pid, oldfd, event.exit_code, cloexec=False)

        elif scname == 'dup2':
            if event.exit_code is not None and event.exit_code >= 0:
                oldfd = event.syscall.get("a0", "0")
                newfd = event.syscall.get("a1", "0")
                self.tracker.dup_fd(pid, oldfd, newfd, cloexec=False)

        elif scname == 'dup3':
            if event.exit_code is not None and event.exit_code >= 0:
                oldfd = event.syscall.get("a0", "0")
                newfd = event.syscall.get("a1", "0")
                flags_raw = event.syscall.get("a2", "0")
                try:
                    fval = int(str(flags_raw), 16) if not str(flags_raw).startswith("-") else int(flags_raw)
                except (ValueError, TypeError):
                    fval = 0
                self.tracker.dup_fd(pid, oldfd, newfd, cloexec=(fval == 0x80000))

        elif scname in ('pipe', 'pipe2'):
            if (event.exit_code == 0 or event.success == 'yes') and event.fd_pair:
                fd0 = event.fd_pair.get("fd0")
                fd1 = event.fd_pair.get("fd1")
                flags_raw = event.syscall.get("a1", "0")
                try:
                    fval = int(str(flags_raw), 16) if not str(flags_raw).startswith("-") else int(flags_raw)
                except (ValueError, TypeError):
                    fval = 0
                cloexec = (scname == "pipe2" and fval == 0x80000)
                if fd0 is not None:
                    self.tracker.set_fd(pid, fd0, "pipe:[...]", cloexec=cloexec)
                if fd1 is not None:
                    self.tracker.set_fd(pid, fd1, "pipe:[...]", cloexec=cloexec)

        elif scname == 'socket':
            if event.exit_code is not None and event.exit_code >= 0:
                dom_val = self.handler._parse_id(event.syscall.get("a0", "0"))
                dom_str = self.handler._format_socket_domain(dom_val)
                type_val = self.handler._parse_id(event.syscall.get("a1", "0"))
                is_cloexec = (type_val & 0x80000 != 0)
                self.tracker.set_fd(pid, event.exit_code, f"socket:[{dom_str}]", cloexec=is_cloexec)

        elif scname == 'socketpair':
            if (event.exit_code == 0 or event.success == 'yes') and event.fd_pair:
                fd0 = event.fd_pair.get("fd0")
                fd1 = event.fd_pair.get("fd1")
                type_val = self.handler._parse_id(event.syscall.get("a1", "0"))
                is_cloexec = (type_val & 0x80000 != 0)
                if fd0 is not None:
                    self.tracker.set_fd(pid, fd0, "socket:[AF_UNIX]", cloexec=is_cloexec)
                if fd1 is not None:
                    self.tracker.set_fd(pid, fd1, "socket:[AF_UNIX]", cloexec=is_cloexec)

        elif scname in ('accept', 'accept4'):
            if event.exit_code is not None and event.exit_code >= 0:
                is_cloexec = False
                if scname == 'accept4':
                    fval = self.handler._parse_id(event.syscall.get("a3", "0"))
                    is_cloexec = (fval & 0x80000 != 0)
                self.tracker.set_fd(pid, event.exit_code, "socket:[...]", cloexec=is_cloexec)

        elif scname == 'fcntl':
            cmd_val = self.handler._parse_id(event.syscall.get("a1", "0"))
            cmd_str = FCNTL_CMDS.get(cmd_val, "")
            if cmd_str in ("F_DUPFD", "F_DUPFD_CLOEXEC") and event.exit_code is not None and event.exit_code >= 0:
                oldfd = event.syscall.get("a0", "0")
                self.tracker.dup_fd(pid, oldfd, event.exit_code, cloexec=(cmd_str == "F_DUPFD_CLOEXEC"))
            elif cmd_str == "F_SETFD" and (event.exit_code == 0 or event.success == 'yes'):
                a0_val = self.handler._parse_id(event.syscall.get("a0", "0"))
                arg_val = self.handler._parse_id(event.syscall.get("a2", "0"))
                proc = self.tracker.get_proc(pid)
                if proc and 'fds' in proc and a0_val in proc['fds']:
                    proc['fds'][a0_val]['cloexec'] = (arg_val == 1)

        elif scname in ('execve', 'execveat'):
            if event.exit_code == 0 or event.success == 'yes':
                self.tracker.handle_exec(pid)

        elif scname in ('exit', 'exit_group'):
            self.tracker.exit_process(pid)

        if formatted:
            try:
                sys.stdout.write(formatted + "\n\n")
                sys.stdout.flush()
            except BrokenPipeError:
                # Python pipe closed (e.g. piped to head)
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
                sys.exit(0)

    def process_stream(self, stream):
        """Feeds audit lines into auparse, handling wrapped/partial lines safely."""
        buffer = ""
        for line in stream:
            line = line.strip("\r\n")
            if not line:
                continue

            # Strip ASCII group separator ^] (0x1d) if present from ausearch
            line = line.replace('\x1d', ' ')

            # If line is human-added text (e.g. from examples or annotations)
            if line.startswith(("    ", "strace:", "audit event:", "audisp-strace entry:")):
                continue

            if line.startswith(("type=", "node=")):
                if buffer:
                    try:
                        self.au.feed(buffer + "\n")
                    except OSError:
                        pass
                buffer = line
            else:
                # Continuation of wrapped line or non-header record
                if buffer:
                    buffer += line
                else:
                    try:
                        self.au.feed(line + "\n")
                    except OSError:
                        pass

        if buffer:
            try:
                self.au.feed(buffer + "\n")
            except OSError:
                pass

        try:
            self.au.flush_feed()
        except OSError:
            pass


def detect_live():
    """Detect if running under auditd or audispd."""
    ppid = os.getppid()
    try:
        ppexe = os.readlink(f"/proc/{ppid}/exe")
        if "auditd" in ppexe or "audispd" in ppexe:
            return True
    except OSError:
        pass
    try:
        with open(f"/proc/{ppid}/comm", "r") as f:
            comm = f.read().strip()
            if comm in ("auditd", "audispd"):
                return True
    except OSError:
        pass
    return False


def setup_signals():
    def signal_handler(sig, frame):
        try:
            sys.stdout.flush()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGHUP, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass


def main():
    setup_signals()

    parser = argparse.ArgumentParser(
        description="Linux audisp plugin & audit log strace-like trace formatter"
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="Audit log files to read (default: stdin)"
    )
    parser.add_argument(
        "-l", "--live",
        action="store_true",
        default=None,
        help="Force live mode (/proc lookups enabled)"
    )
    parser.add_argument(
        "--offline",
        action="store_true",
        help="Force offline mode (/proc lookups disabled)"
    )
    parser.add_argument(
        "-t", "--timestamp-format",
        choices=["time", "datetime", "epoch"],
        default="time",
        help="Timestamp format (default: time, e.g. 17:53:01.027)"
    )
    parser.add_argument(
        "-s", "--syscalls",
        help="Comma-separated list of syscalls or %%CLASS shorthands to monitor (e.g. %%creds,%%net,openat)"
    )
    parser.add_argument(
        "-x", "-X", "--exclude",
        dest="exclude",
        help="Comma-separated list of syscalls or %%CLASS shorthands to exclude (e.g. %%desc,openat)"
    )
    parser.add_argument(
        "-a", "--all",
        dest="all_syscalls",
        action="store_true",
        help="Display all captured syscalls, not just permissions and process lifecycle"
    )

    args = parser.parse_args()

    # Determine live mode
    if args.offline:
        is_live = False
    elif args.live is True:
        is_live = True
    else:
        is_live = detect_live()

    syscalls_filter = expand_syscall_spec(args.syscalls)
    exclude_filter = expand_syscall_spec(args.exclude)

    app = AudispStraceApp(
        is_live=is_live,
        time_format=args.timestamp_format,
        all_syscalls=args.all_syscalls,
        syscalls=syscalls_filter,
        exclude_syscalls=exclude_filter
    )

    if args.files:
        for file_path in args.files:
            if file_path == "-":
                app.process_stream(sys.stdin)
            else:
                try:
                    with open(file_path, "r", errors="replace") as f:
                        app.process_stream(f)
                except OSError as e:
                    sys.stderr.write(f"audisp-strace: cannot read {file_path}: {e}\n")
    else:
        app.process_stream(sys.stdin)


if __name__ == "__main__":
    main()
