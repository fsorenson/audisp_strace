    def _format_signalfd_flags(self, flags_raw):
        f = self._parse_id(flags_raw)
        if not isinstance(f, int) or f == 0:
            return "0"
        flags = []
        if f & 0x80000:
            flags.append("SFD_CLOEXEC")
        if f & 0x800:
            flags.append("SFD_NONBLOCK")
        rem = f & ~(0x80000 | 0x800)
        if rem:
            flags.append(hex(rem))
        return "|".join(flags) if flags else "0"

    def _format_uring_enter_flags(self, flags_raw):
        f = self._parse_id(flags_raw)
        if not isinstance(f, int) or f == 0:
            return "0"
        flags = []
        if f & (1 << 0): flags.append("IORING_ENTER_GETEVENTS")
        if f & (1 << 1): flags.append("IORING_ENTER_SQ_WAKEUP")
        if f & (1 << 2): flags.append("IORING_ENTER_SQ_WAIT")
        if f & (1 << 3): flags.append("IORING_ENTER_EXT_ARG")
        if f & (1 << 4): flags.append("IORING_ENTER_REGISTERED_RING")
        if f & (1 << 5): flags.append("IORING_ENTER_ABS_TIMER")
        if f & (1 << 6): flags.append("IORING_ENTER_EXT_ARG_REG")
        if f & (1 << 7): flags.append("IORING_ENTER_NO_IOWAIT")
        rem = f & ~((1 << 8) - 1)
        if rem:
            flags.append(hex(rem))
        return "|".join(flags) if flags else "0"

    def _format_shadow_stack_flags(self, flags_raw):
        f = self._parse_id(flags_raw)
