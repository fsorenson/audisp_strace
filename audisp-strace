    def handle_semop(self, event, scname=None):
        scname = scname or event.syscall_name or "semop"
        semid = self._parse_id(event.syscall.get("a0", "0"))
        nsops = self._parse_id(event.syscall.get("a2", "0"))
        if scname == "semtimedop":
            to_ptr = self._parse_id(event.syscall.get("a3", "0"))
            to_str = ", NULL" if to_ptr == 0 else ", {...}"
            return f"semtimedop({semid}, [{nsops}], {nsops}{to_str}) = {event.exit_str}"
        return f"semop({semid}, [{nsops}], {nsops}) = {event.exit_str}"

    def handle_semctl(self, event):
        semid = self._parse_id(event.syscall.get("a0", "0"))
        semnum = self._parse_id(event.syscall.get("a1", "0"))
