    def handle_ptrace(self, event):
        req = self._parse_id(event.syscall.get("a0", "0"))
        req_str = PTRACE_REQUESTS.get(req, f"0x{req:x}" if isinstance(req, int) else str(req))
        if req == 0:  # PTRACE_TRACEME
            return f"ptrace({req_str}) = {event.exit_str}"

        pid = self._format_int(event.syscall.get("a1", "0"))
        if req in (16, 0x4207, 8, 0x4208):  # ATTACH, INTERRUPT, KILL, LISTEN
            return f"ptrace({req_str}, {pid}) = {event.exit_str}"

        addr_str = self._format_pointer(event.syscall.get("a2", "0"))
        a3 = event.syscall.get("a3", "0")

        if req in (7, 17, 24, 9):  # CONT, DETACH, SYSCALL, SINGLESTEP
            data_str = self._format_sig(a3)
        elif req == 0x4200:  # PTRACE_SETOPTIONS
            data_val = self._parse_id(a3)
            data_str = self._format_bitmask(data_val, PTRACE_O_FLAGS)
        else:
            data_str = self._format_pointer(a3)

        return f"ptrace({req_str}, {pid}, {addr_str}, {data_str}) = {event.exit_str}"

    def handle_kcmp(self, event):
        pid1 = self._format_int(event.syscall.get("a0", "0"))
