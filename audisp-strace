            return f"kcmp({pid1}, {pid2}, {type_str}) = {event.exit_str}"

        idx1 = self._parse_id(event.syscall.get("a3", "0"))
        idx2 = self._parse_id(event.syscall.get("a4", "0"))
        if ktype == 0:  # KCMP_FILE
            return f"kcmp({pid1}, {pid2}, {type_str}, {idx1}, {idx2}) = {event.exit_str}"
        else:
            idx1_str = f"0x{idx1:x}" if isinstance(idx1, int) else str(idx1)
            idx2_str = f"0x{idx2:x}" if isinstance(idx2, int) else str(idx2)
            return f"kcmp({pid1}, {pid2}, {type_str}, {idx1_str}, {idx2_str}) = {event.exit_str}"

