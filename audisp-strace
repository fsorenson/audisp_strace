            return "0"
        flags = []
        for bit, name in SHADOW_STACK_FLAGS.items():
            if f & bit:
                flags.append(name)
        rem = f & ~3
        if rem:
            flags.append(hex(rem))
        return "|".join(flags) if flags else "0"

    def _get_pathname(self, event, default_arg="a0"):
        if event.paths:
            for p in event.paths:
                if p.get("nametype") != "PARENT":
                    name = p.get("name", "").strip('"')
                    if name:
                        return name
            name = event.paths[0].get("name", "").strip('"')
            if name:
                return name
        raw = event.syscall.get(default_arg, "")
        return raw.strip('"')

    def handle_fchmodat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        # Path name from PATH record or a1
        name = event.paths[0].get("name") if event.paths else event.syscall.get("a1", "")
        name = name.strip('"')
        mode_str = self._resolve_mode(event.syscall.get("a2"), event.syscall_interp.get("a2"))

        call_str = f"fchmodat({dirfd_str}, \"{name}\", {mode_str}) = {event.exit_str}"
        return call_str

    def handle_chmod(self, event):
        name = event.paths[0].get("name") if event.paths else event.syscall.get("a0", "")
        name = name.strip('"')
        mode_str = self._resolve_mode(event.syscall.get("a1"), event.syscall_interp.get("a1"))

        call_str = f"chmod(\"{name}\", {mode_str}) = {event.exit_str}"
        return call_str

    def handle_fchmod(self, event):
        fd_str = self._resolve_fd(event, "a0")
        mode_str = self._resolve_mode(event.syscall.get("a1"), event.syscall_interp.get("a1"))
        return f"fchmod({fd_str}, {mode_str}) = {event.exit_str}"

    def _parse_id(self, val):
        if val is None or val == "":
            return -1
        try:
            val_int = int(str(val), 16) if not str(val).startswith("-") else int(val)
            if val_int in (4294967295, 0xffffffff):
                return -1
            return val_int
        except (ValueError, TypeError):
            return val

    def handle_fchownat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = event.paths[0].get("name") if event.paths else event.syscall.get("a1", "")
        name = name.strip('"')
        uid_val = self._parse_id(event.syscall.get("a2", "-1"))
        gid_val = self._parse_id(event.syscall.get("a3", "-1"))

        flags_val = event.syscall.get("a4") or "0"
        try:
            flags_int = int(str(flags_val), 16) if not str(flags_val).startswith('-') else int(flags_val)
        except ValueError:
            flags_int = 0
        flags_str = "AT_SYMLINK_NOFOLLOW" if flags_int == 0x100 else str(flags_int)

        call_str = f"fchownat({dirfd_str}, \"{name}\", {uid_val}, {gid_val}, {flags_str}) = {event.exit_str}"
        return call_str

    def handle_chown_lchown(self, event, scname=None):
        scname = scname or event.syscall_name
        name = event.paths[0].get("name") if event.paths else event.syscall.get("a0", "")
        name = name.strip('"')
        uid_val = self._parse_id(event.syscall.get("a1", "-1"))
        gid_val = self._parse_id(event.syscall.get("a2", "-1"))

        call_str = f"{scname}(\"{name}\", {uid_val}, {gid_val}) = {event.exit_str}"
        return call_str

    def handle_fchown(self, event):
        fd_str = self._resolve_fd(event, "a0")
        uid_val = self._parse_id(event.syscall.get("a1", "-1"))
        gid_val = self._parse_id(event.syscall.get("a2", "-1"))
        return f"fchown({fd_str}, {uid_val}, {gid_val}) = {event.exit_str}"

    def handle_mkdir(self, event):
        name = self._get_path_by_nametype(event, ("CREATE", "NORMAL"), default_idx=len(event.paths) - 1)
        name = name.strip('"')
        mode_str = self._resolve_mode(event.syscall.get("a1", "0777"), event.syscall_interp.get("a1"))
        return f"mkdir(\"{name}\", {mode_str}) = {event.exit_str}"

    def handle_mkdirat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_path_by_nametype(event, ("CREATE", "NORMAL"), default_idx=len(event.paths) - 1)
        name = name.strip('"')
        mode_str = self._resolve_mode(event.syscall.get("a2", "0777"), event.syscall_interp.get("a2"))
        return f"mkdirat({dirfd_str}, \"{name}\", {mode_str}) = {event.exit_str}"

    def handle_rmdir(self, event):
        name = self._get_path_by_nametype(event, ("DELETE", "NORMAL"), default_idx=len(event.paths) - 1)
        name = name.strip('"')
        return f"rmdir(\"{name}\") = {event.exit_str}"

    def _resolve_link_paths(self, event):
        old_path = ""
        new_path = ""
        create_items = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") == "CREATE"]
        other_items = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") not in ("CREATE", "PARENT")]
        if other_items:
            old_path = other_items[0]
        if create_items:
            new_path = create_items[-1]

        if not old_path or not new_path:
            non_parents = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") != "PARENT"]
            if len(non_parents) >= 2:
                old_path = non_parents[0]
                new_path = non_parents[1]
            elif len(non_parents) == 1:
                if not old_path:
                    old_path = non_parents[0]
                else:
                    new_path = non_parents[0]

        if (not old_path or not new_path) and event.proctitle:
            parts = event.proctitle.split()
            args = [p for p in parts if not p.startswith('-') and os.path.basename(p) not in ('ln', 'xauth')]
            if len(args) >= 2:
                old_path = old_path or args[-2]
                new_path = new_path or args[-1]

        return old_path or "unknown", new_path or "unknown"

    def handle_link(self, event):
        old_path, new_path = self._resolve_link_paths(event)
        return f"link(\"{old_path}\", \"{new_path}\") = {event.exit_str}"

    def handle_linkat(self, event):
        old_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        new_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a2"))
        old_path, new_path = self._resolve_link_paths(event)
        flags_val = event.syscall.get("a4", "0")
        try:
            flags_int = int(str(flags_val), 16) if not str(flags_val).startswith('-') else int(flags_val)
        except ValueError:
            flags_int = 0
        flags_str = "AT_SYMLINK_FOLLOW" if flags_int == 0x400 else str(flags_int)
        return f"linkat({old_dirfd_str}, \"{old_path}\", {new_dirfd_str}, \"{new_path}\", {flags_str}) = {event.exit_str}"

    def handle_symlink(self, event):
        target, linkpath = self._resolve_link_paths(event)
        return f"symlink(\"{target}\", \"{linkpath}\") = {event.exit_str}"

    def handle_symlinkat(self, event):
        target, linkpath = self._resolve_link_paths(event)
        new_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a1"))
        return f"symlinkat(\"{target}\", {new_dirfd_str}, \"{linkpath}\") = {event.exit_str}"

    def handle_setuid(self, event):
        uid = self._parse_id(event.syscall.get("a0", "0"))
        return f"setuid({uid}) = {event.exit_str}"

    def handle_setgid(self, event):
        gid = self._parse_id(event.syscall.get("a0", "0"))
        return f"setgid({gid}) = {event.exit_str}"

    def handle_get_id(self, event, scname=None):
        scname = scname or event.syscall_name
        return f"{scname}() = {event.exit_str}"

    def handle_setre_id(self, event, scname=None):
        scname = scname or event.syscall_name
        r = self._parse_id(event.syscall.get("a0", "-1"))
        e = self._parse_id(event.syscall.get("a1", "-1"))
        return f"{scname}({r}, {e}) = {event.exit_str}"

    def handle_setres_id(self, event, scname=None):
        scname = scname or event.syscall_name
        r = self._parse_id(event.syscall.get("a0", "-1"))
        e = self._parse_id(event.syscall.get("a1", "-1"))
        s = self._parse_id(event.syscall.get("a2", "-1"))
        return f"{scname}({r}, {e}, {s}) = {event.exit_str}"

    def handle_getres_id(self, event, scname=None):
        scname = scname or event.syscall_name
        return f"{scname}([...], [...], [...]) = {event.exit_str}"

    def handle_setfs_id(self, event, scname=None):
        scname = scname or event.syscall_name
        fid = self._parse_id(event.syscall.get("a0", "-1"))
        return f"{scname}({fid}) = {event.exit_str}"

    def handle_getgroups(self, event):
        size = self._parse_id(event.syscall.get("a0", "0"))
        list_ptr = self._parse_id(event.syscall.get("a1", "0"))
        list_str = "NULL" if list_ptr == 0 else "[...]"
        return f"getgroups({size}, {list_str}) = {event.exit_str}"

    def handle_setgroups(self, event):
        size = self._parse_id(event.syscall.get("a0", "0"))
        return f"setgroups({size}, [...]) = {event.exit_str}"

    def handle_cap(self, event, scname=None):
        scname = scname or event.syscall_name
        hdr_ptr = self._parse_id(event.syscall.get("a0", "0"))
        hdr_str = "NULL" if hdr_ptr == 0 else "{...}"
        data_ptr = self._parse_id(event.syscall.get("a1", "0"))
        data_str = "NULL" if data_ptr == 0 else "[...]"
        return f"{scname}({hdr_str}, {data_str}) = {event.exit_str}"

    def handle_prctl(self, event):
        opt_val = self._parse_id(event.syscall.get("a0", "0"))
        opt_str = PRCTL_OPTIONS.get(opt_val, f"0x{opt_val:x}" if opt_val > 0x1000 else str(opt_val))
        a1 = self._parse_id(event.syscall.get("a1", "0"))
        if opt_str == "PR_SET_NAME":
            interp_name = event.syscall_interp.get("a1")
            if interp_name and not interp_name.startswith("0x"):
                clean_name = interp_name.strip('"')
                arg_tail = f'"{clean_name}"'
            else:
                arg_tail = f"0x{a1:x}" if a1 else "NULL"
        elif opt_str in ("PR_GET_NAME", "PR_GET_DUMPABLE", "PR_GET_KEEPCAPS", "PR_GET_NO_NEW_PRIVS", "PR_GET_SECCOMP"):
            arg_tail = ""
        else:
            arg_tail = str(a1)
        args = f"{opt_str}, {arg_tail}" if arg_tail else opt_str
        return f"prctl({args}) = {event.exit_str}"

    def _get_path_by_nametype(self, event, nametypes, default_idx=0):
        for p in event.paths:
            nt = p.get("nametype", "")
            if nt in nametypes:
                return p.get("name", "")
        if event.paths and 0 <= default_idx < len(event.paths):
            return event.paths[default_idx].get("name", "")
        return ""

    def handle_unlink(self, event):
        name = self._get_path_by_nametype(event, ("DELETE", "NORMAL"), default_idx=len(event.paths) - 1)
        name = name.strip('"')
        return f"unlink(\"{name}\") = {event.exit_str}"

    def handle_unlinkat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_path_by_nametype(event, ("DELETE", "NORMAL"), default_idx=len(event.paths) - 1)
        name = name.strip('"')
        flags_val = event.syscall.get("a2", "0")
        try:
            flags_int = int(str(flags_val), 16) if not str(flags_val).startswith("-") else int(flags_val)
        except ValueError:
            flags_int = 0
        flags_str = "AT_REMOVEDIR" if flags_int == 0x200 else str(flags_int)
        return f"unlinkat({dirfd_str}, \"{name}\", {flags_str}) = {event.exit_str}"

    def _resolve_rename_paths(self, event):
        old_path = ""
        new_path = ""
        delete_items = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") == "DELETE"]
        create_items = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") == "CREATE"]
        if delete_items:
            old_path = delete_items[0]
        if create_items:
            new_path = create_items[-1]
        elif len(delete_items) > 1:
            new_path = delete_items[-1]

        if not old_path or not new_path:
            non_parents = [p.get("name", "").strip('"') for p in event.paths if p.get("nametype") != "PARENT"]
            if len(non_parents) >= 2:
                old_path = non_parents[0]
                new_path = non_parents[1]
            elif len(non_parents) == 1:
                if not old_path:
                    old_path = non_parents[0]
                else:
                    new_path = non_parents[0]

        if (not old_path or not new_path) and event.proctitle:
            parts = event.proctitle.split()
            if len(parts) >= 3 and os.path.basename(parts[0]) == "mv":
                old_path = old_path or parts[-2]
                new_path = new_path or parts[-1]

        return old_path or "unknown", new_path or "unknown"

    def handle_rename(self, event):
        old_path, new_path = self._resolve_rename_paths(event)
        return f"rename(\"{old_path}\", \"{new_path}\") = {event.exit_str}"

    def handle_renameat(self, event):
        old_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        new_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a2"))
        old_path, new_path = self._resolve_rename_paths(event)
        return f"renameat({old_dirfd_str}, \"{old_path}\", {new_dirfd_str}, \"{new_path}\") = {event.exit_str}"

    def handle_renameat2(self, event):
        old_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        new_dirfd_str = self._resolve_dirfd(event, event.syscall.get("a2"))
        old_path, new_path = self._resolve_rename_paths(event)
        # Note: Linux audit only records a0..a3 in SYSCALL records, so flags (the 5th argument) is not stored
        return f"renameat2({old_dirfd_str}, \"{old_path}\", {new_dirfd_str}, \"{new_path}\", ...) = {event.exit_str}"

    def handle_open(self, event):
        name = event.paths[0].get("name", "") if event.paths else event.syscall.get("a0", "")
        name = name.strip('"')
        flags_interp = event.syscall_interp.get("a1") or event.syscall.get("a1", "O_RDONLY")
        if "O_CREAT" in flags_interp or "O_TMPFILE" in flags_interp:
            mode_str = self._resolve_mode(event.syscall.get("a2", "0"), event.syscall_interp.get("a2"))
            call_str = f"open(\"{name}\", {flags_interp}, {mode_str}) = {event.exit_str}"
        else:
            call_str = f"open(\"{name}\", {flags_interp}) = {event.exit_str}"
        return call_str

    def handle_openat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = ""
        for p in event.paths:
            if p.get("nametype") != "PARENT":
                name = p.get("name", "")
                break
        if not name and event.paths:
            name = event.paths[0].get("name", "")
        name = name.strip('"')

        flags_interp = event.syscall_interp.get("a2") or event.syscall.get("a2", "O_RDONLY")
        if "O_CREAT" in flags_interp or "O_TMPFILE" in flags_interp:
            mode_str = self._resolve_mode(event.syscall.get("a3", "0"), event.syscall_interp.get("a3"))
            call_str = f"openat({dirfd_str}, \"{name}\", {flags_interp}, {mode_str}) = {event.exit_str}"
        else:
            call_str = f"openat({dirfd_str}, \"{name}\", {flags_interp}) = {event.exit_str}"
        return call_str

    def handle_openat2(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = event.paths[0].get("name", "") if event.paths else ""
        name = name.strip('"')
        return f"openat2({dirfd_str}, \"{name}\", {{...}}) = {event.exit_str}"

    def handle_creat(self, event):
        name = event.paths[0].get("name", "") if event.paths else ""
        name = name.strip('"')
        mode_str = self._resolve_mode(event.syscall.get("a1", "0"), event.syscall_interp.get("a1"))
        return f"creat(\"{name}\", {mode_str}) = {event.exit_str}"

    def handle_close(self, event):
        fd_str = self._resolve_fd(event, "a0")
        return f"close({fd_str}) = {event.exit_str}"

    def handle_readlink(self, event):
        name = self._get_pathname(event, "a0")
        bufsiz = self._parse_id(event.syscall.get("a2", "1024"))
        return f"readlink(\"{name}\", ..., {bufsiz}) = {event.exit_str}"

    def handle_readlinkat(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_pathname(event, "a1")
        bufsiz = self._parse_id(event.syscall.get("a3", "1024"))
        return f"readlinkat({dirfd_str}, \"{name}\", ..., {bufsiz}) = {event.exit_str}"

    def handle_stat_lstat(self, event, scname=None):
        scname = scname or event.syscall_name
        name = self._get_pathname(event, "a0")
        return f"{scname}(\"{name}\", {{...}}) = {event.exit_str}"

    def handle_fstat(self, event):
        fd_str = self._resolve_fd(event, "a0")
        return f"fstat({fd_str}, {{...}}) = {event.exit_str}"

    def handle_newfstatat(self, event, scname=None):
        scname = scname or event.syscall_name or "newfstatat"
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_pathname(event, "a1")
        flags_val = self._parse_id(event.syscall.get("a3", "0"))
        if flags_val == 0x100:
            flags_str = "AT_SYMLINK_NOFOLLOW"
        elif flags_val == 0x1000:
            flags_str = "AT_EMPTY_PATH"
        elif flags_val == 0x1100:
            flags_str = "AT_SYMLINK_NOFOLLOW|AT_EMPTY_PATH"
        else:
            flags_str = str(flags_val)
        return f"{scname}({dirfd_str}, \"{name}\", {{...}}, {flags_str}) = {event.exit_str}"

    def handle_statx(self, event):
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_pathname(event, "a1")
        flags_val = self._parse_id(event.syscall.get("a2", "0"))
        mask_val = self._parse_id(event.syscall.get("a3", "0"))
        flags_str = "AT_SYMLINK_NOFOLLOW" if flags_val == 0x100 else str(flags_val)
        return f"statx({dirfd_str}, \"{name}\", {flags_str}, {mask_val:#x}, {{...}}) = {event.exit_str}"

    def handle_statfs(self, event):
        name = self._get_pathname(event, "a0")
        return f"statfs(\"{name}\", {{...}}) = {event.exit_str}"

    def handle_fstatfs(self, event):
        fd_str = self._resolve_fd(event, "a0")
        return f"fstatfs({fd_str}, {{...}}) = {event.exit_str}"

    def handle_ustat(self, event):
        dev_str = self._format_dev(event.syscall.get("a0", "0"))
        ubuf_val = self._parse_id(event.syscall.get("a1", "0"))
        if ubuf_val == 0:
            ubuf_str = "NULL"
        elif not event.is_success:
            ubuf_str = f"0x{ubuf_val:x}"
        else:
            ubuf_str = "{...}"
        return f"ustat({dev_str}, {ubuf_str}) = {event.exit_str}"

    def handle_access(self, event):
        name = self._get_pathname(event, "a0")
        mode_str = self._format_access_mode(event.syscall.get("a1", "0"))
        return f"access(\"{name}\", {mode_str}) = {event.exit_str}"

    def handle_faccessat(self, event, scname=None):
        scname = scname or event.syscall_name or "faccessat"
        dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
        name = self._get_pathname(event, "a1")
        mode_str = self._format_access_mode(event.syscall.get("a2", "0"))
        flags_val = self._parse_id(event.syscall.get("a3", "0"))
        if flags_val == 0x200:
            flags_str = "AT_EACCESS"
        elif flags_val == 0x100:
            flags_str = "AT_SYMLINK_NOFOLLOW"
        else:
            flags_str = str(flags_val)
        if flags_val == 0 and scname == "faccessat":
            return f"faccessat({dirfd_str}, \"{name}\", {mode_str}) = {event.exit_str}"
        return f"{scname}({dirfd_str}, \"{name}\", {mode_str}, {flags_str}) = {event.exit_str}"

    def handle_dup(self, event):
        fd_str = self._resolve_fd(event, "a0")
        return f"dup({fd_str}) = {event.exit_str}"

    def handle_dup2(self, event):
        old_fd_str = self._resolve_fd(event, "a0")
        new_fd = self._parse_id(event.syscall.get("a1", "0"))
        return f"dup2({old_fd_str}, {new_fd}) = {event.exit_str}"

    def handle_dup3(self, event):
        old_fd_str = self._resolve_fd(event, "a0")
        new_fd = self._parse_id(event.syscall.get("a1", "0"))
        flags_val = self._parse_id(event.syscall.get("a2", "0"))
        flags_str = "O_CLOEXEC" if flags_val == 0x80000 else str(flags_val)
        return f"dup3({old_fd_str}, {new_fd}, {flags_str}) = {event.exit_str}"

    def handle_truncate(self, event):
        name = self._get_pathname(event, "a0")
        length = self._parse_id(event.syscall.get("a1", "0"))
        return f"truncate(\"{name}\", {length}) = {event.exit_str}"

    def handle_ftruncate(self, event):
        fd_str = self._resolve_fd(event, "a0")
        length = self._parse_id(event.syscall.get("a1", "0"))
        return f"ftruncate({fd_str}, {length}) = {event.exit_str}"

    def handle_fallocate(self, event):
        fd_str = self._resolve_fd(event, "a0")
        mode = self._parse_id(event.syscall.get("a1", "0"))
        if mode == 1:
            mode_str = "FALLOC_FL_KEEP_SIZE"
        elif mode == 3:
            mode_str = "FALLOC_FL_PUNCH_HOLE|FALLOC_FL_KEEP_SIZE"
        else:
            mode_str = str(mode)
        offset = self._parse_id(event.syscall.get("a2", "0"))
        length = self._parse_id(event.syscall.get("a3", "0"))
        return f"fallocate({fd_str}, {mode_str}, {offset}, {length}) = {event.exit_str}"

    def _format_inotify_mask(self, mask):
        if not isinstance(mask, int) or mask == 0:
            return "0"
        flags = [name for bit, name in INOTIFY_MASKS if mask & bit]
        leftover = mask
        for bit, _ in INOTIFY_MASKS:
            leftover &= ~bit
        if leftover:
            flags.append(f"0x{leftover:x}")
        return "|".join(flags) if flags else "0"

    def _format_mount_flags(self, flags):
        if not isinstance(flags, int) or flags == 0:
            return "0"
        res = [name for bit, name in MOUNT_FLAGS if flags & bit]
        leftover = flags
        for bit, _ in MOUNT_FLAGS:
            leftover &= ~bit
        if leftover:
            res.append(f"0x{leftover:x}")
        return "|".join(res) if res else "0"

    def _format_umount_flags(self, flags):
        if not isinstance(flags, int) or flags == 0:
            return "0"
        res = [name for bit, name in UMOUNT_FLAGS if flags & bit]
        leftover = flags
        for bit, _ in UMOUNT_FLAGS:
            leftover &= ~bit
        if leftover:
            res.append(f"0x{leftover:x}")
        return "|".join(res) if res else "0"

    def handle_xattr(self, event, scname=None):
        scname = scname or event.syscall_name
        if scname.endswith("at"):
            dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
            name = self._get_pathname(event, "a1")
            target_str = f'{dirfd_str}, "{name}"'
        elif scname.startswith("f"):
            target_str = self._resolve_fd(event, "a0")
        else:
            target_str = f'"{self._get_pathname(event, "a0")}"'
        if "get" in scname or "set" in scname:
            return f"{scname}({target_str}, ..., ...) = {event.exit_str}"
        return f"{scname}({target_str}, ...) = {event.exit_str}"

    def handle_chdir(self, event):
        name = self._get_pathname(event, "a0")
        return f'chdir("{name}") = {event.exit_str}'

    def handle_chroot(self, event):
        name = self._get_pathname(event, "a0")
        return f'chroot("{name}") = {event.exit_str}'

    def handle_getcwd(self, event):
        size = self._parse_id(event.syscall.get("a1", "0"))
        # In live mode, verify ground truth via /proc/<pid>/cwd if accessible
        resolved_cwd = self.resolver.get_cwd(event.pid)
        if (
            resolved_cwd
            and event.exit_code is not None
            and event.exit_code > 0
            and len(resolved_cwd) + 1 == event.exit_code
        ):
            buf_str = f'"{resolved_cwd}"'
        else:
            raw_buf = event.syscall.get("a0", "0")
            try:
                buf_val = int(str(raw_buf), 16) if not str(raw_buf).startswith("-") else int(raw_buf)
                buf_str = f"0x{buf_val:x}" if buf_val else "NULL"
            except (ValueError, TypeError):
                buf_str = str(raw_buf)
        return f"getcwd({buf_str}, {size}) = {event.exit_str}"

    def handle_acct(self, event):
        raw_a0 = self._parse_id(event.syscall.get("a0", "0"))
        if raw_a0 == 0:
            target = "NULL"
        else:
            target = f'"{self._get_pathname(event, "a0")}"'
        return f"acct({target}) = {event.exit_str}"

    def handle_inotify_add_watch(self, event):
        fd_str = self._resolve_fd(event, "a0")
        name = self._get_pathname(event, "a1")
        mask = self._parse_id(event.syscall.get("a2", "0"))
        mask_str = self._format_inotify_mask(mask)
        return f'inotify_add_watch({fd_str}, "{name}", {mask_str}) = {event.exit_str}'

    def handle_quotactl(self, event):
        cmd = self._parse_id(event.syscall.get("a0", "0"))
        subcmd = (cmd >> 8) & 0xffffff
        qtype = cmd & 0xff
        subcmd_str = QUOTA_SUBCMDS.get(subcmd, QUOTA_SUBCMDS.get(cmd >> 8, str(subcmd)))
        type_str = QUOTA_TYPES.get(qtype, str(qtype))
        if isinstance(subcmd_str, str) and subcmd_str.startswith("Q_"):
            cmd_str = f"QCMD({subcmd_str}, {type_str})"
        else:
            cmd_str = f"0x{cmd:x}" if cmd else "0"

        special = self._get_pathname(event, "a1")
        id_val = self._parse_id(event.syscall.get("a2", "0"))
        addr = self._parse_id(event.syscall.get("a3", "0"))
