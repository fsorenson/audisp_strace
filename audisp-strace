    def handle_pipe(self, event, scname=None):
        scname = scname or event.syscall_name or "pipe"
        flags = ""
        if scname == "pipe2":
            fval = self._parse_id(event.syscall.get("a1", "0"))
            flags = ", O_CLOEXEC" if fval == 0x80000 else f", {fval}"
        if event.fd_pair:
            fd0 = event.fd_pair.get("fd0", "?")
            fd1 = event.fd_pair.get("fd1", "?")
            return f"{scname}([{fd0}, {fd1}]{flags}) = {event.exit_str}"
        return f"{scname}([...]{flags}) = {event.exit_str}"

    def handle_utime(self, event, scname=None):
        scname = scname or event.syscall_name
        if scname in ("futimesat", "utimensat"):
            dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
            name = self._get_pathname(event, "a1")
            if scname == "utimensat":
                flags_val = self._parse_id(event.syscall.get("a3", "0"))
                flags_str = ", AT_SYMLINK_NOFOLLOW" if flags_val == 0x100 else (f", {flags_val}" if flags_val else "")
                return f"utimensat({dirfd_str}, \"{name}\", [...]{flags_str}) = {event.exit_str}"
            return f"futimesat({dirfd_str}, \"{name}\", [...]) = {event.exit_str}"
        name = self._get_pathname(event, "a0")
        return f"{scname}(\"{name}\", [...]) = {event.exit_str}"

