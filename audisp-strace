        flags_str = ""
        if scname == "accept4":
            fval = self._parse_id(event.syscall.get("a3", "0"))
            flags_str = ", SOCK_CLOEXEC" if fval == 0x80000 else (f", {fval}" if fval else ", 0")
        return f"{scname}({fd_str}, {sa_str}, [...]{flags_str}) = {event.exit_str}"

    def handle_getsockname(self, event, scname=None):
