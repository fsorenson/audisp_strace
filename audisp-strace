    def handle_futex(self, event):
        uaddr = self._format_pointer(event.syscall.get("a0", "0"))
        op_val = self._parse_id(event.syscall.get("a1", "0"))
        op_str = self._format_futex_op(op_val)
        cmd = op_val & 127 if isinstance(op_val, int) else -1

        val = self._parse_id(event.syscall.get("a2", "0"))
        timeout = self._format_pointer(event.syscall.get("a3", "0"))
        val2 = self._parse_id(event.syscall.get("a3", "0"))
        uaddr2 = self._format_pointer(event.syscall.get("a4", "0"))
        val3 = self._parse_id(event.syscall.get("a5", "0"))

        if cmd == 0:  # FUTEX_WAIT
            args_str = f"{uaddr}, {op_str}, {val}, {timeout}"
        elif cmd in (1, 2):  # FUTEX_WAKE, FUTEX_FD
            args_str = f"{uaddr}, {op_str}, {val}"
        elif cmd in (6, 13):  # FUTEX_LOCK_PI, FUTEX_LOCK_PI2
            args_str = f"{uaddr}, {op_str}, {timeout}"
        elif cmd in (7, 8):  # FUTEX_UNLOCK_PI, FUTEX_TRYLOCK_PI
            args_str = f"{uaddr}, {op_str}"
        elif cmd == 9:  # FUTEX_WAIT_BITSET
            bs_str = self._format_futex_bitset(val3)
            args_str = f"{uaddr}, {op_str}, {val}, {timeout}, {bs_str}"
        elif cmd == 10:  # FUTEX_WAKE_BITSET
            bs_str = self._format_futex_bitset(val3)
            args_str = f"{uaddr}, {op_str}, {val}, {bs_str}"
        elif cmd == 3:  # FUTEX_REQUEUE
            args_str = f"{uaddr}, {op_str}, {val}, {val2}, {uaddr2}"
        elif cmd in (4, 12):  # FUTEX_CMP_REQUEUE, FUTEX_CMP_REQUEUE_PI
            args_str = f"{uaddr}, {op_str}, {val}, {val2}, {uaddr2}, {val3}"
        elif cmd == 11:  # FUTEX_WAIT_REQUEUE_PI
            args_str = f"{uaddr}, {op_str}, {val}, {timeout}, {uaddr2}"
        else:
            args_str = f"{uaddr}, {op_str}, {val}, {timeout}, {uaddr2}, 0x{val3:x}"

        return f"futex({args_str}) = {event.exit_str}"

