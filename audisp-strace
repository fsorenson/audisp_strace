    def _resolve_dirfd(self, event, a0_val):
        try:
            val_int = int(str(a0_val), 16) if isinstance(a0_val, str) and not str(a0_val).startswith("-") else int(a0_val)
        except (ValueError, TypeError):
            val_int = 0

        # Check for AT_FDCWD
        if val_int in (-100, 0xffffff9c, 4294967196):
            cwd = event.cwd or "unknown"
            return f"AT_FDCWD<{cwd}>"

        # Otherwise it's a numeric fd
        path = self.tracker.get_fd_path(event.pid, val_int)
        if path:
            return f"{val_int}<{path}>"
        return str(val_int)

    def _resolve_mode(self, raw_mode, interp_mode):
        if interp_mode and interp_mode.startswith('0'):
            return interp_mode
        try:
            int_val = int(raw_mode, 16) if str(raw_mode).startswith('0x') else int(str(raw_mode), 16)
            return f"0{int_val:o}"
        except (ValueError, TypeError):
            return str(raw_mode)

    def _resolve_fd(self, event, field_name="a0"):
        fd_raw = event.syscall.get(field_name, "0")
        try:
            val_int = int(str(fd_raw), 16) if not str(fd_raw).startswith("-") else int(fd_raw)
        except (ValueError, TypeError):
            val_int = 0
        path = self.tracker.get_fd_path(event.pid, val_int) if self.tracker else None
        return f"{val_int}<{path}>" if path else str(val_int)

    def get_opened_path(self, event):
        scname = event.syscall_name
        name = ""
        if scname in ('openat', 'openat2'):
            for p in event.paths:
                if p.get("nametype") != "PARENT":
                    name = p.get("name", "")
                    if name:
                        break
            if not name and event.paths:
                name = event.paths[0].get("name", "")
            if not name:
                name = event.syscall.get("a1", "")
        else:
            if event.paths:
                for p in event.paths:
                    if p.get("nametype") != "PARENT":
                        name = p.get("name", "")
                        if name:
                            break
                if not name:
                    name = event.paths[0].get("name", "")
            if not name:
                name = event.syscall.get("a0", "")

        name = name.strip('"')
        if not name:
            return None

        # Absolute path
        if name.startswith('/'):
            return name

        # Relative path: resolve against dirfd or cwd
        if scname in ('openat', 'openat2'):
            dirfd_val = event.syscall.get("a0")
            try:
                dfd_int = int(str(dirfd_val), 16) if not str(dirfd_val).startswith("-") else int(dirfd_val)
            except (ValueError, TypeError):
                dfd_int = 0
            if dfd_int not in (-100, 0xffffff9c, 4294967196):
                dirfd_path = self.tracker.get_fd_path(event.pid, dfd_int)
                if dirfd_path:
                    return os.path.normpath(os.path.join(dirfd_path, name))

        if event.cwd:
            return os.path.normpath(os.path.join(event.cwd, name))

        return name

    def is_cloexec_opened(self, event):
        scname = event.syscall_name
        if scname == 'open':
            flags = event.syscall_interp.get("a1") or str(event.syscall.get("a1", ""))
            return "O_CLOEXEC" in flags or (self._parse_id(event.syscall.get("a1", "0")) & 0x80000 != 0)
        elif scname == 'openat':
            flags = event.syscall_interp.get("a2") or str(event.syscall.get("a2", ""))
            return "O_CLOEXEC" in flags or (self._parse_id(event.syscall.get("a2", "0")) & 0x80000 != 0)
        return False

    def _format_access_mode(self, mode_val):
        try:
            m = int(str(mode_val), 16) if not str(mode_val).startswith("-") else int(mode_val)
        except (ValueError, TypeError):
            return str(mode_val)
        if m == 0:
            return "F_OK"
        flags = []
        if m & 4:
            flags.append("R_OK")
        if m & 2:
            flags.append("W_OK")
        if m & 1:
            flags.append("X_OK")
        return "|".join(flags) if flags else str(m)

    def _format_dev(self, dev_val):
        try:
            d = int(str(dev_val), 16) if not str(dev_val).startswith("-") else int(dev_val)
            major = ((d >> 8) & 0xfff) | ((d >> 32) & ~0xfff)
            minor = (d & 0xff) | ((d >> 12) & ~0xff)
            return f"makedev(0x{major:x}, 0x{minor:x})"
        except (ValueError, TypeError):
            return str(dev_val)

    def _format_prot(self, prot_raw):
        p = self._parse_id(prot_raw)
        if p == 0:
            return "PROT_NONE"
        flags = []
        if p & 1: flags.append("PROT_READ")
        if p & 2: flags.append("PROT_WRITE")
        if p & 4: flags.append("PROT_EXEC")
        if p & 0x10: flags.append("PROT_GROWSDOWN")
        if p & 0x20: flags.append("PROT_GROWSUP")
        return "|".join(flags) if flags else f"0x{p:x}"

    def _format_mmap_flags(self, flags_raw):
        f = self._parse_id(flags_raw)
        flags = []
        if f & 0x01: flags.append("MAP_SHARED")
        if f & 0x02: flags.append("MAP_PRIVATE")
        if f & 0x10: flags.append("MAP_FIXED")
        if f & 0x20: flags.append("MAP_ANONYMOUS")
        if f & 0x100: flags.append("MAP_GROWSDOWN")
        if f & 0x800: flags.append("MAP_DENYWRITE")
        if f & 0x1000: flags.append("MAP_EXECUTABLE")
        if f & 0x2000: flags.append("MAP_LOCKED")
        if f & 0x4000: flags.append("MAP_NORESERVE")
        if f & 0x8000: flags.append("MAP_POPULATE")
        if f & 0x10000: flags.append("MAP_NONBLOCK")
        if f & 0x20000: flags.append("MAP_STACK")
        if f & 0x40000: flags.append("MAP_HUGETLB")
        if f & 0x80000: flags.append("MAP_SYNC")
        if f & 0x100000: flags.append("MAP_FIXED_NOREPLACE")
        return "|".join(flags) if flags else f"0x{f:x}"

    def _format_socket_domain(self, dom_raw):
        d = self._parse_id(dom_raw)
        return SOCKET_DOMAINS.get(d, str(d))

    def _format_socket_type(self, type_raw):
        t = self._parse_id(type_raw)
        base = t & 0xf
        base_str = SOCKET_TYPES.get(base, str(base))
        flags = []
        if t & 0x800: flags.append("SOCK_NONBLOCK")
        if t & 0x80000: flags.append("SOCK_CLOEXEC")
        if flags:
            return f"{base_str}|{'|'.join(flags)}"
        return base_str

    def _format_socket_proto(self, proto_raw, dom_val):
        p = self._parse_id(proto_raw)
        if p == 0:
            return "IPPROTO_IP" if dom_val in (2, 10) else "0"
        return SOCKET_PROTO.get(p, str(p))

    def _format_sockaddr(self, event, arg_idx="a1", len_idx="a2"):
        if event.sockaddr_interp and "saddr" in event.sockaddr_interp:
            s = event.sockaddr_interp["saddr"].strip()
            if s.startswith("{") and s.endswith("}"):
                inner = s[1:-1].strip()
                kv = dict(part.split("=", 1) for part in inner.split() if "=" in part)
                fam = kv.get("saddr_fam", "")
                if fam == "inet":
                    port = kv.get("lport", "0")
                    addr = kv.get("laddr", "0.0.0.0")
                    return f"{{sa_family=AF_INET, sin_port=htons({port}), sin_addr=inet_addr(\"{addr}\")}}"
                elif fam == "inet6":
                    port = kv.get("lport", "0")
                    addr = kv.get("laddr", "::")
                    return f"{{sa_family=AF_INET6, sin6_port=htons({port}), sin6_addr=inet_pton(\"{addr}\")}}"
                elif fam == "local":
                    path = kv.get("path", "")
                    return f"{{sa_family=AF_UNIX, sun_path=\"{path}\"}}"
                elif fam == "netlink":
                    pid = kv.get("nlnk-pid", "0")
                    return f"{{sa_family=AF_NETLINK, pid={pid}}}"
                else:
                    return s
            return s
        addr_ptr = self._parse_id(event.syscall.get(arg_idx, "0"))
        return "{...}" if addr_ptr else "NULL"

    def _format_sig(self, sig_raw):
        s = self._parse_id(sig_raw)
        if s in SIGNALS:
            return SIGNALS[s]
        if isinstance(s, int) and s > 32:
            return f"SIGRT_{s - 32}"
        return str(s)

    def _format_wait_options(self, opts_raw):
        opts = self._parse_id(opts_raw)
        if not isinstance(opts, int) or opts == 0:
            return "0"
        flags = []
        for bit, name in WAIT_OPTIONS.items():
            if opts & bit:
                flags.append(name)
        return "|".join(flags) if flags else hex(opts)

    def _format_sockopt(self, lvl_val, opt_val):
        lvl_str = SOCKET_LEVELS.get(lvl_val, str(lvl_val))
        if lvl_val == 1:
            opt_str = SOL_SOCKET_OPTS.get(opt_val, str(opt_val))
        elif lvl_val == 6:
            opt_str = TCP_OPTS.get(opt_val, str(opt_val))
        else:
            opt_str = str(opt_val)
        return lvl_str, opt_str

