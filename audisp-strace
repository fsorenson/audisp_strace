    def handle_fallocate(self, event):
        fd_str = self._resolve_fd(event, "a0")
        mode = self._parse_id(event.syscall.get("a1", "0"))
        if mode == 1:
            mode_str = "FALLOC_FL_KEEP_SIZE"
        elif mode == 3:
            mode_str = "FALLOC_FL_PUNCH_HOLE|FALLOC_FL_KEEP_SIZE"
        else:
            mode_str = str(mode)
        offset = self._parse_id(event.syscall.get("a2", "0"))
        length = self._parse_id(event.syscall.get("a3", "0"))
        return f"fallocate({fd_str}, {mode_str}, {offset}, {length}) = {event.exit_str}"

    def _format_inotify_mask(self, mask):
        if not isinstance(mask, int) or mask == 0:
            return "0"
        flags = [name for bit, name in INOTIFY_MASKS if mask & bit]
        leftover = mask
        for bit, _ in INOTIFY_MASKS:
            leftover &= ~bit
        if leftover:
            flags.append(f"0x{leftover:x}")
        return "|".join(flags) if flags else "0"

    def _format_mount_flags(self, flags):
        if not isinstance(flags, int) or flags == 0:
            return "0"
        res = [name for bit, name in MOUNT_FLAGS if flags & bit]
        leftover = flags
        for bit, _ in MOUNT_FLAGS:
            leftover &= ~bit
        if leftover:
            res.append(f"0x{leftover:x}")
        return "|".join(res) if res else "0"

    def _format_umount_flags(self, flags):
        if not isinstance(flags, int) or flags == 0:
            return "0"
        res = [name for bit, name in UMOUNT_FLAGS if flags & bit]
        leftover = flags
        for bit, _ in UMOUNT_FLAGS:
            leftover &= ~bit
        if leftover:
            res.append(f"0x{leftover:x}")
        return "|".join(res) if res else "0"

    def handle_xattr(self, event, scname=None):
        scname = scname or event.syscall_name
        if scname.endswith("at"):
            dirfd_str = self._resolve_dirfd(event, event.syscall.get("a0"))
            name = self._get_pathname(event, "a1")
            target_str = f'{dirfd_str}, "{name}"'
        elif scname.startswith("f"):
            target_str = self._resolve_fd(event, "a0")
        else:
            target_str = f'"{self._get_pathname(event, "a0")}"'
        if "get" in scname or "set" in scname:
            return f"{scname}({target_str}, ..., ...) = {event.exit_str}"
        return f"{scname}({target_str}, ...) = {event.exit_str}"

    def handle_chdir(self, event):
