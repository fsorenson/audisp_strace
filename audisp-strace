        dest_str = ""
        if event.sockaddr:
            sa_str = self._format_sockaddr(event, "a4", "a5")
            dest_str = f", {sa_str}, {self._parse_id(event.syscall.get('a5', '16'))}"
        return f"sendto({fd_str}, \"...\", {len_val}, {flags_val}{dest_str}) = {event.exit_str}"

