        proto_str = self._format_socket_proto(event.syscall.get("a2", "0"), dom_val)
        if event.fd_pair:
            fd0 = event.fd_pair.get("fd0", "?")
            fd1 = event.fd_pair.get("fd1", "?")
            sv_str = f"[{fd0}, {fd1}]"
        else:
            sv_str = "[...]"
        return f"socketpair({dom_str}, {type_str}, {proto_str}, {sv_str}) = {event.exit_str}"

