def expand_syscall_spec(spec_str):
    """Expands a comma-separated string of syscall names and/or %CLASS shorthands.

    Returns a set of syscall names, or None if spec_str is None.
    """
    if spec_str is None:
        return None
    selected = set()
    for item in spec_str.split(","):
        item = item.strip()
        if not item:
            continue
        if item in SYSCALL_CLASSES:
            selected.update(SYSCALL_CLASSES[item])
        elif item.startswith("%"):
            sys.stderr.write(f"audisp-strace: invalid syscall class '{item}'\n")
            sys.exit(1)
        else:
            selected.add(item)
    return selected


def unescape_audit_str(val):
    """Strips quotes and decodes hex-encoded audit strings if applicable."""
    if not val:
        return ""
    val = val.strip('"')
    if len(val) >= 2 and len(val) % 2 == 0:
        if all(c in string.hexdigits for c in val):
            try:
                raw_bytes = bytes.fromhex(val)
                # Replace NUL bytes if coming from proctitle or argv
                decoded = raw_bytes.replace(b'\x00', b' ').decode('utf-8', errors='replace').strip()
                if decoded and all(c.isprintable() or c in '\t\n\r ' for c in decoded):
                    return decoded
            except (ValueError, UnicodeDecodeError):
                pass
    return val


class ProcResolver:
    """Helper for reading /proc metadata when running live."""

    def __init__(self, is_live=False):
        self.is_live = is_live

    def get_fd_path(self, pid, fd):
        if not self.is_live:
            return None
        try:
            return os.readlink(f"/proc/{pid}/fd/{fd}")
        except OSError:
            return None

    def get_exe(self, pid):
        if not self.is_live:
            return None
        try:
            return os.readlink(f"/proc/{pid}/exe")
        except OSError:
            return None

    def get_cwd(self, pid):
        if not self.is_live:
            return None
        try:
            return os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return None

    def get_proc_stat(self, pid):
        """Returns (ppid, comm) from /proc/<pid>/stat if accessible."""
        if not self.is_live:
            return None, None
        try:
            with open(f"/proc/{pid}/stat", "r") as f:
                content = f.read().strip()
            # stat format: pid (comm) state ppid ...
            rparen = content.rfind(')')
            if rparen != -1:
                comm = content[content.find('(') + 1:rparen]
                rest = content[rparen + 2:].split()
                ppid = int(rest[1])
                return ppid, comm
        except (OSError, ValueError, IndexError):
            pass
        return None, None


class ProcessTracker:
    """Maintains known process tree, credentials, and ancestry."""

    def __init__(self, proc_resolver):
        self.resolver = proc_resolver
        self.procs = {}  # pid -> dict(ppid, comm, exe, cmdline, ses)

    def update(self, pid, ppid=None, comm=None, exe=None, cmdline=None, ses=None):
        if pid is None:
            return
        try:
            pid = int(pid)
        except ValueError:
            return

        if pid not in self.procs:
            self.procs[pid] = {
                'ppid': None,
                'comm': None,
                'exe': None,
                'cmdline': None,
                'ses': None,
                'fds': {}
            }

        proc = self.procs[pid]
        if 'fds' not in proc:
            proc['fds'] = {}
        if ppid is not None:
            try:
                proc['ppid'] = int(ppid)
            except ValueError:
                pass
        if comm:
            proc['comm'] = comm.strip('"')
        if exe:
            proc['exe'] = exe.strip('"')
        if cmdline:
            proc['cmdline'] = cmdline
        if ses is not None:
            proc['ses'] = ses

    def _parse_fd(self, val):
        if val is None:
            return None
        if isinstance(val, int):
            return val
        s = str(val).strip()
        if not s:
            return None
        try:
            return int(s) if s.startswith('-') else int(s, 16)
        except ValueError:
            return None

    def get_fd_path(self, pid, fd):
        if pid is None:
            return None
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return None
        fd_num = self._parse_fd(fd)
        if fd_num is None:
            return None

        proc = self.procs.get(pid)
        if proc and 'fds' in proc and fd_num in proc['fds']:
            return proc['fds'][fd_num]['path']

        # Fall back to live /proc resolver if available
        if self.resolver and self.resolver.is_live:
            path = self.resolver.get_fd_path(pid, fd_num)
            if path:
                if proc is None:
                    self.update(pid)
                    proc = self.procs[pid]
                if 'fds' not in proc:
                    proc['fds'] = {}
                proc['fds'][fd_num] = {'path': path, 'cloexec': False}
                return path
        return None

    def set_fd(self, pid, fd, path, cloexec=False):
        if pid is None or not path:
            return
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return
        fd_num = self._parse_fd(fd)
        if fd_num is None:
            return
        if pid not in self.procs:
            self.update(pid)
        proc = self.procs[pid]
        if 'fds' not in proc:
            proc['fds'] = {}
        proc['fds'][fd_num] = {'path': path, 'cloexec': cloexec}

    def close_fd(self, pid, fd):
        if pid is None:
            return
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return
        fd_num = self._parse_fd(fd)
        if fd_num is None:
            return
        proc = self.procs.get(pid)
        if proc and 'fds' in proc:
            proc['fds'].pop(fd_num, None)

    def dup_fd(self, pid, oldfd, newfd, cloexec=False):
        if pid is None:
            return
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return
        old_num = self._parse_fd(oldfd)
        new_num = self._parse_fd(newfd)
        if old_num is None or new_num is None:
            return
        path = self.get_fd_path(pid, old_num)
        if path:
            self.set_fd(pid, new_num, path, cloexec=cloexec)

    def copy_fds(self, parent_pid, child_pid):
        try:
            parent_pid = int(parent_pid)
            child_pid = int(child_pid)
        except (ValueError, TypeError):
            return
        parent_proc = self.procs.get(parent_pid)
        if not parent_proc or 'fds' not in parent_proc:
            return
        if child_pid not in self.procs:
            self.update(child_pid)
        child_proc = self.procs[child_pid]
        if 'fds' not in child_proc:
            child_proc['fds'] = {}
        for fd, info in parent_proc['fds'].items():
            child_proc['fds'][fd] = dict(info)

    def handle_exec(self, pid):
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return
        proc = self.procs.get(pid)
        if proc and 'fds' in proc:
            proc['fds'] = {fd: info for fd, info in proc['fds'].items() if not info.get('cloexec')}

    def exit_process(self, pid):
        # We retain information for ancestry lookups of already-finished parents,
        # but clear open file descriptors.
        try:
            pid = int(pid)
            proc = self.procs.get(pid)
            if proc and 'fds' in proc:
                proc['fds'].clear()
        except (ValueError, TypeError):
            pass

    def get_proc(self, pid):
        return self.procs.get(pid)

    def _resolve_name(self, pid):
        proc = self.procs.get(pid)
        if proc:
            if proc.get('comm'):
                return proc['comm']
            if proc.get('exe'):
                return os.path.basename(proc['exe'])

        # Live /proc fallback
        if self.resolver.is_live:
            exe = self.resolver.get_exe(pid)
            if exe:
                name = os.path.basename(exe)
                if proc:
                    proc['exe'] = exe
                return name
            _, comm = self.resolver.get_proc_stat(pid)
            if comm:
                if proc:
                    proc['comm'] = comm
                return comm

        if pid == 1:
            return "systemd"
        return "unknown"

    def get_ancestry(self, pid):
        """Returns full ancestry list [(pid, name), ...] from root ancestor to pid."""
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return []

        chain = []
        curr = pid
        visited = set()

        while curr and curr not in visited:
            visited.add(curr)
            proc = self.procs.get(curr)

            ppid = proc.get('ppid') if proc else None

            # If ppid missing and live, check /proc
            if (ppid is None or curr not in self.procs) and self.resolver.is_live:
                live_ppid, live_comm = self.resolver.get_proc_stat(curr)
                if live_ppid is not None:
                    ppid = live_ppid
                    self.update(curr, ppid=live_ppid, comm=live_comm)

            name = self._resolve_name(curr)
            chain.append((curr, name))

            if curr == 1 or ppid == 0 or ppid == curr or ppid is None:
                break
            curr = ppid

        chain.reverse()
        return chain


class AuditEvent:
    """Represents a parsed multi-record audit event."""

    def __init__(self, au):
        ts = au.get_timestamp()
        self.sec = ts.sec
        self.milli = ts.milli
        self.serial = ts.serial

        self.records = []
        self.syscall = {}
        self.syscall_interp = {}
        self.cwd = None
        self.paths = []
        self.execve_args = []
        self.proctitle = None
        self.fd_pair = None
        self.sockaddr = None
        self.sockaddr_interp = None

        au.first_record()
        while True:
            rectype = au.get_type_name()
            fields = {}
            interp_fields = {}
            au.first_field()
            while True:
                fname = au.get_field_name()
                try:
                    fstr = au.get_field_str()
                except Exception:
                    fstr = ""
                fields[fname] = fstr

                try:
                    interp = au.interpret_field()
                except Exception:
                    interp = None

                if interp is not None:
                    interp_fields[fname] = interp
                if not au.next_field():
                    break

            self.records.append((rectype, fields, interp_fields))

            if rectype == "SYSCALL":
                self.syscall = fields
                self.syscall_interp = interp_fields
            elif rectype == "CWD":
                cwd_val = fields.get("cwd", "")
                self.cwd = unescape_audit_str(cwd_val)
            elif rectype == "PATH":
                # Unescape path names
                p_copy = dict(fields)
                if "name" in p_copy:
                    p_copy["name"] = unescape_audit_str(p_copy["name"])
                self.paths.append(p_copy)
            elif rectype == "EXECVE":
                try:
                    argc = int(fields.get("argc", 0))
                except ValueError:
                    argc = 0
                args = []
                for i in range(argc):
                    arg = fields.get(f"a{i}")
                    if arg is not None:
                        args.append(unescape_audit_str(arg))
                self.execve_args = args
            elif rectype == "PROCTITLE":
                proctitle = interp_fields.get("proctitle") or fields.get("proctitle")
                if proctitle:
                    self.proctitle = unescape_audit_str(proctitle)
            elif rectype == "FD_PAIR":
                self.fd_pair = fields
            elif rectype == "SOCKADDR":
                self.sockaddr = fields
                self.sockaddr_interp = interp_fields

            if not au.next_record():
                break

    @property
    def syscall_name(self):
        return self.syscall_interp.get("syscall") or self.syscall.get("syscall")

    @property
    def pid(self):
        val = self.syscall.get("pid")
        return int(val) if val is not None else None

    @property
    def ppid(self):
        val = self.syscall.get("ppid")
        return int(val) if val is not None else None

    @property
    def comm(self):
        val = self.syscall.get("comm")
        return val.strip('"') if val else None

    @property
    def exe(self):
        val = self.syscall.get("exe")
        return val.strip('"') if val else None

    @property
    def exit_code(self):
        val = self.syscall.get("exit")
        return int(val) if val is not None else None

    @property
    def success(self):
        return self.syscall.get("success")

    @property
    def exit_str(self):
        exit_val = self.exit_code
        if exit_val is None:
            return "?"
        if exit_val < 0:
            interp = self.syscall_interp.get("exit")
            return f"-1 {interp}" if interp else str(exit_val)
        return str(exit_val)


class TraceFormatter:
    """Formats 3-line strace-like output."""

    def __init__(self, time_format="time"):
        self.time_format = time_format
        self._uid_cache = {}
        self._gid_cache = {}

    def resolve_user(self, uid_str, fallback=""):
        if uid_str is None or uid_str == "" or uid_str in ("4294967295", "-1"):
            return "unset"
        if uid_str in self._uid_cache:
            return self._uid_cache[uid_str]
        try:
            name = pwd.getpwuid(int(uid_str)).pw_name
        except (KeyError, ValueError, OverflowError):
            name = fallback if fallback else uid_str
        self._uid_cache[uid_str] = name
        return name

    def resolve_group(self, gid_str, fallback=""):
        if gid_str is None or gid_str == "" or gid_str in ("4294967295", "-1"):
            return "unset"
        if gid_str in self._gid_cache:
            return self._gid_cache[gid_str]
        try:
            name = grp.getgrgid(int(gid_str)).gr_name
        except (KeyError, ValueError, OverflowError):
            name = fallback if fallback else gid_str
        self._gid_cache[gid_str] = name
        return name

    def format_timestamp(self, sec, milli):
        dt = datetime.datetime.fromtimestamp(sec).astimezone()
        if self.time_format == "time":
            return f"{dt.strftime('%H:%M:%S')}.{milli:03d}"
        elif self.time_format == "datetime":
            return f"{dt.strftime('%Y-%m-%d %H:%M:%S')}.{milli:03d} {dt.strftime('%z')}"
        elif self.time_format == "epoch":
            return f"{sec}.{milli:03d}"
        return f"{dt.strftime('%H:%M:%S')}.{milli:03d}"

    def format_credentials(self, event):
        fields = event.syscall
        interp = event.syscall_interp

        def clean_name(val):
            if not val:
                return ""
            val = val.strip('"')
            if val.startswith("unknown(") and val.endswith(")"):
                return val[8:-1]
            return val

        # Expected credentials: uid, gid, auid, agid, euid, egid, suid, sgid, fsuid, fsgid
        auid_str = fields.get("auid", "0")
        raw_auid_name = clean_name(fields.get("AUID") or interp.get("auid"))
        auid_name = self.resolve_user(auid_str, raw_auid_name or "root")

        # Derive agid from auid primary group if possible
        agid_str = fields.get("agid")
        raw_agid_name = clean_name(fields.get("AGID"))
        if agid_str is None:
            try:
                pw = pwd.getpwuid(int(auid_str))
                agid_str = str(pw.pw_gid)
                agid_name = raw_agid_name or self.resolve_group(agid_str)
            except (KeyError, ValueError, OverflowError):
                agid_str = "0"
                agid_name = raw_agid_name or "root"
        else:
            agid_name = raw_agid_name or self.resolve_group(agid_str)

        items = [
            ("uid", fields.get("uid", "0"), clean_name(fields.get("UID") or interp.get("uid"))),
            ("gid", fields.get("gid", "0"), clean_name(fields.get("GID") or interp.get("gid"))),
            ("auid", auid_str, auid_name),
            ("agid", agid_str, agid_name),
            ("euid", fields.get("euid", "0"), clean_name(fields.get("EUID") or interp.get("euid"))),
            ("egid", fields.get("egid", "0"), clean_name(fields.get("EGID") or interp.get("egid"))),
            ("suid", fields.get("suid", "0"), clean_name(fields.get("SUID") or interp.get("suid"))),
            ("sgid", fields.get("sgid", "0"), clean_name(fields.get("SGID") or interp.get("sgid"))),
            ("fsuid", fields.get("fsuid", "0"), clean_name(fields.get("FSUID") or interp.get("fsuid"))),
            ("fsgid", fields.get("fsgid", "0"), clean_name(fields.get("FSGID") or interp.get("fsgid"))),
        ]

        formatted_creds = []
        for key, val_id, hint_name in items:
            if "gid" in key:
                name = hint_name or self.resolve_group(val_id)
            else:
                name = hint_name or self.resolve_user(val_id)
            name = clean_name(name)
            formatted_creds.append(f"{key}={val_id} ({name})")

        return "    " + ", ".join(formatted_creds)

    def format_ancestry(self, ancestry):
        if not ancestry:
            return "    ???"
        parts = [f"{pid} ({name})" for pid, name in ancestry]
        return "    " + "->".join(parts)


