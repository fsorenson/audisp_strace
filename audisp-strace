        return f'inotify_add_watch({fd_str}, "{name}", {mask_str}) = {event.exit_str}'

    def handle_quotactl(self, event):
        cmd = self._parse_id(event.syscall.get("a0", "0"))
        subcmd = (cmd >> 8) & 0xffffff
        qtype = cmd & 0xff
        subcmd_str = QUOTA_SUBCMDS.get(subcmd, QUOTA_SUBCMDS.get(cmd >> 8, str(subcmd)))
        type_str = QUOTA_TYPES.get(qtype, str(qtype))
        if isinstance(subcmd_str, str) and subcmd_str.startswith("Q_"):
            cmd_str = f"QCMD({subcmd_str}, {type_str})"
        else:
            cmd_str = f"0x{cmd:x}" if cmd else "0"

        special = self._get_pathname(event, "a1")
        id_val = self._parse_id(event.syscall.get("a2", "0"))
        addr = self._parse_id(event.syscall.get("a3", "0"))
        addr_str = f"0x{addr:x}" if addr else "NULL"
        return f'quotactl({cmd_str}, "{special}", {id_val}, {addr_str}) = {event.exit_str}'

    def handle_mount(self, event):
        source = ""
        target = ""
        if len(event.paths) >= 2:
            target = event.paths[0].get("name", "").strip('"')
            source = event.paths[1].get("name", "").strip('"')
        elif len(event.paths) == 1:
            target = event.paths[0].get("name", "").strip('"')
        if not target:
            target = self._get_pathname(event, "a1")
        if not source:
            source = self._get_pathname(event, "a0") or "none"
        fstype_raw = self._parse_id(event.syscall.get("a2", "0"))
        fstype_str = "NULL" if fstype_raw == 0 else '"..."'
        flags_val = self._parse_id(event.syscall.get("a3", "0"))
        flags_str = self._format_mount_flags(flags_val)
        return f'mount("{source}", "{target}", {fstype_str}, {flags_str}, ...) = {event.exit_str}'

