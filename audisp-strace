    def handle_keyctl(self, event):
        cmd = self._parse_id(event.syscall.get("a0", "0"))
        cmd_str = KEYCTL_COMMANDS.get(cmd, f"0x{cmd:x}" if isinstance(cmd, int) else str(cmd))
        a1 = event.syscall.get("a1", "0")
        a2 = event.syscall.get("a2", "0")
        a3 = event.syscall.get("a3", "0")
        a4 = event.syscall.get("a4", "0")

        if cmd == 0:  # KEYCTL_GET_KEYRING_ID
            k_str = self._format_key_serial(a1)
            create = self._format_int(a2)
            args_str = f"{cmd_str}, {k_str}, {create}"
        elif cmd == 1:  # KEYCTL_JOIN_SESSION_KEYRING
            p1_str = self._format_pointer(a1)
            args_str = f"{cmd_str}, {p1_str}"
        elif cmd == 2:  # KEYCTL_UPDATE
            k_str = self._format_key_serial(a1)
            p_str = self._format_pointer(a2)
            plen = self._parse_id(a3)
            args_str = f"{cmd_str}, {k_str}, {p_str}, {plen}"
        elif cmd in (3, 7, 21, 16):  # REVOKE, CLEAR, INVALIDATE, ASSUME_AUTHORITY
            k_str = self._format_key_serial(a1)
            args_str = f"{cmd_str}, {k_str}"
        elif cmd in (8, 9):  # LINK, UNLINK
            k1_str = self._format_key_serial(a1)
            k2_str = self._format_key_serial(a2)
            args_str = f"{cmd_str}, {k1_str}, {k2_str}"
        elif cmd in (6, 11, 17):  # DESCRIBE, READ, GET_SECURITY
            k_str = self._format_key_serial(a1)
            buf_str = self._format_pointer(a2)
            buflen = self._parse_id(a3)
            args_str = f"{cmd_str}, {k_str}, {buf_str}, {buflen}"
        elif cmd == 10:  # SEARCH
            k1_str = self._format_key_serial(a1)
            t_str = self._format_pointer(a2)
            d_str = self._format_pointer(a3)
            k2_str = self._format_key_serial(a4)
            args_str = f"{cmd_str}, {k1_str}, {t_str}, {d_str}, {k2_str}"
        elif cmd == 4:  # CHOWN
            k_str = self._format_key_serial(a1)
            u = self._format_int(a2)
            g = self._format_int(a3)
            args_str = f"{cmd_str}, {k_str}, {u}, {g}"
        elif cmd == 5:  # SETPERM
            k_str = self._format_key_serial(a1)
            perm = self._parse_id(a2)
            perm_str = f"0{perm:o}" if isinstance(perm, int) else str(perm)
            args_str = f"{cmd_str}, {k_str}, {perm_str}"
        elif cmd == 14:  # SET_REQKEY_KEYRING
            rk = self._parse_id(a1)
            if isinstance(rk, int) and rk >= 0x80000000:
                rk -= 0x100000000
            rk_str = KEY_REQKEYS.get(rk, str(rk))
            args_str = f"{cmd_str}, {rk_str}"
        elif cmd == 15:  # SET_TIMEOUT
            k_str = self._format_key_serial(a1)
            to = self._parse_id(a2)
            args_str = f"{cmd_str}, {k_str}, {to}"
        elif cmd == 18:  # SESSION_TO_PARENT
            args_str = f"{cmd_str}"
        elif cmd == 31:  # CAPABILITIES
            buf_str = self._format_pointer(a1)
            buflen = self._parse_id(a2)
            args_str = f"{cmd_str}, {buf_str}, {buflen}"
        else:
            p1_str = self._format_pointer(a1)
            p2_str = self._format_pointer(a2)
            p3_str = self._format_pointer(a3)
            p4_str = self._format_pointer(a4)
            args_str = f"{cmd_str}, {p1_str}, {p2_str}, {p3_str}, {p4_str}"

        return f"keyctl({args_str}) = {event.exit_str}"

