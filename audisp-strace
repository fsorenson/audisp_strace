        old_sz = self._parse_id(event.syscall.get("a1", "0"))
        new_sz = self._parse_id(event.syscall.get("a2", "0"))
        flags_str = self._format_mremap_flags(event.syscall.get("a3", "0"))
        if event.exit_code is not None and event.exit_code >= 0:
            ret_str = f"0x{event.exit_code:x}"
        else:
            ret_str = event.exit_str
        return f"mremap({addr_str}, {old_sz}, {new_sz}, {flags_str}) = {ret_str}"

    def handle_msync(self, event):
        addr_val = self._parse_id(event.syscall.get("a0", "0"))
