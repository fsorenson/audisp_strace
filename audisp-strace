        if flags_val == 0 and scname == "faccessat":
            return f"faccessat({dirfd_str}, \"{name}\", {mode_str}) = {event.exit_str}"
        return f"{scname}({dirfd_str}, \"{name}\", {mode_str}, {flags_str}) = {event.exit_str}"

