    def handle_io_uring_enter(self, event):
        fd_str = self._resolve_fd(event, "a0")
        to_submit = self._parse_id(event.syscall.get("a1", "0"))
        min_complete = self._parse_id(event.syscall.get("a2", "0"))
        flags_val = self._parse_id(event.syscall.get("a3", "0"))
        flags_str = self._format_uring_enter_flags(flags_val)
        arg_ptr = self._parse_id(event.syscall.get("a4", "0"))
        argsz_val = self._parse_id(event.syscall.get("a5", "0"))
        if arg_ptr == 0:
            arg_str = "NULL"
        elif isinstance(flags_val, int) and (flags_val & (1 << 3)):
            arg_str = "{...}"
        elif isinstance(flags_val, int) and (flags_val & (1 << 6)):
            arg_str = str(arg_ptr)
        else:
            arg_str = "[...]"
        return f"io_uring_enter({fd_str}, {to_submit}, {min_complete}, {flags_str}, {arg_str}, {argsz_val}) = {event.exit_str}"

    def handle_io_uring_register(self, event):
        opcode_raw = self._parse_id(event.syscall.get("a1", "0"))
        is_reg_ring = False
        if isinstance(opcode_raw, int):
            is_reg_ring = bool(opcode_raw & 0x80000000)
            op = opcode_raw & ~0x80000000
        else:
            op = opcode_raw
        if is_reg_ring:
            fd_str = str(self._parse_id(event.syscall.get("a0", "0")))
        else:
            fd_str = self._resolve_fd(event, "a0")
        op_str = IORING_REGISTER_OPCODES.get(op, hex(op) if isinstance(op, int) else str(op))
        if is_reg_ring:
            op_str += "|IORING_REGISTER_USE_REGISTERED_RING"
        arg_ptr = self._parse_id(event.syscall.get("a2", "0"))
        arg_str = "NULL" if arg_ptr == 0 else f"0x{arg_ptr:x}"
        nr_args = self._parse_id(event.syscall.get("a3", "0"))
        return f"io_uring_register({fd_str}, {op_str}, {arg_str}, {nr_args}) = {event.exit_str}"

