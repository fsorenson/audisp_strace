    def handle_io_uring_register(self, event):
        opcode_raw = self._parse_id(event.syscall.get("a1", "0"))
        is_reg_ring = False
        if isinstance(opcode_raw, int):
            is_reg_ring = bool(opcode_raw & 0x80000000)
            op = opcode_raw & ~0x80000000
        else:
            op = opcode_raw
        if is_reg_ring:
            fd_str = str(self._parse_id(event.syscall.get("a0", "0")))
        else:
            fd_str = self._resolve_fd(event, "a0")
        op_str = IORING_REGISTER_OPCODES.get(op, hex(op) if isinstance(op, int) else str(op))
        if is_reg_ring:
            op_str += "|IORING_REGISTER_USE_REGISTERED_RING"
        arg_ptr = self._parse_id(event.syscall.get("a2", "0"))
        arg_str = "NULL" if arg_ptr == 0 else f"0x{arg_ptr:x}"
        nr_args = self._parse_id(event.syscall.get("a3", "0"))
        return f"io_uring_register({fd_str}, {op_str}, {arg_str}, {nr_args}) = {event.exit_str}"

